<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: none of the app's data goes into a cloud backup
     or a transfer to a new phone. The manifest's android:allowBackup="false"
     covers older versions, and on some makers' phones it stops only the
     cloud backup. "root" and "device_root" hold every other domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
