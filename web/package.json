{
  "name": "neptune-vault",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "wasm:prover": "wasm-pack build ../crates/vault-prover --target web --release --out-dir ../../web/public/wasm/prover -- --locked",
    "wasm:prover-legacy": "wasm-pack build ../crates/legacy/vault-prover-legacy --target web --release --out-dir ../../../web/public/wasm/prover-legacy -- --locked",
    "wasm:core": "wasm-pack build ../crates/vault-core --target web --release --out-dir ../../web/public/wasm/core -- --locked"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tabler/icons-react": "^3.31.0",
    "@tauri-apps/api": "2.11.1",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.0.0",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  }
}
